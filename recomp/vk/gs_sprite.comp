#endif
#ifdef COPIES
                pi = i;
#else
                p = prims[i];
#endif
#ifdef COPIES
                apply_copy(zc);
#endif
                if (x < PF(px0) || x >= PF(px1) || y < PF(py0) || y >= PF(py1)) continue;
                draw_at(x, y);
            }
        }
        barrier();
    }
}
