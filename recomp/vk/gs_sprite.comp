// A batch holds each primitive once; the GPU derives its copies (apply_copy). The exact build: a workgroup is an 8x8
// tile of local memory. The copies build: an 8x8 tile of the upscaled picture, invocation (X, Y) drawing copy
// 1 + X%N + (Y%N)*N at pixel (X/N, Y/N), so the invocations of a workgroup draw the copies of one small area: a
// triangle that covers a pixel covers it in most copies, which keeps them busy together (one tile per copy, as
// before, left most invocations idle on the small triangles of 3D scenes).
void main() {
    uint lid = gl_LocalInvocationIndex;
#ifdef COPIES
    const int N = int(sqrt(float(pc.ncopy - 1)) + 0.5), nper = pc.n;
    const int X = int(gl_GlobalInvocationID.x), Y = int(gl_GlobalInvocationID.y), HX = int(gl_WorkGroupID.x) * 8, HY = int(gl_WorkGroupID.y) * 8;
    const int zc = 1 + X % N + (Y % N) * N, x = pc.bx0 + X / N, y = pc.by0 + Y / N;
    const int tx0 = pc.bx0 + HX / N, tx1 = pc.bx0 + (HX + 7) / N + 1, ty0 = pc.by0 + HY / N, ty1 = pc.by0 + (HY + 7) / N + 1;   // the tile's pixels
#else
    const int zc = 0, nper = pc.n;
    int x = pc.bx0 + int(gl_GlobalInvocationID.x), y = pc.by0 + int(gl_GlobalInvocationID.y);
    int tx0 = pc.bx0 + int(gl_WorkGroupID.x) * 8, ty0 = pc.by0 + int(gl_WorkGroupID.y) * 8, tx1 = tx0 + 8, ty1 = ty0 + 8;
#endif
#ifdef COPIES
    const bool binned = pc.binoff >= 0; const int nwb = (nper + 31) >> 5;
    int binbase = 0;
    if (binned) binbase = pc.binoff + (min((ty0 - pc.by0) / BIN, pc.binh - 1) * pc.binw + min((tx0 - pc.bx0) / BIN, pc.binw - 1)) * nwb;
#endif
    for (int base = 0; base < nper; base += 256) {
#ifdef COPIES
        if (binned) {   // (the same for the whole workgroup) none of these 256 near this tile's square: next
            uint any = 0u; for (int w = 0; w < 8 && (base >> 5) + w < nwb; w++) any |= bins[binbase + (base >> 5) + w];
            if (any == 0u) continue;
        }
#endif
        if (lid < 8u) hits[lid] = 0u;
