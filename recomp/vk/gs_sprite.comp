#version 450
// GS sprite rasterizer on the GPU: one invocation per pixel of the sprite's rectangle, doing exactly what gs.c's
// draw_sprite() -> shade() -> pixel() do for the same pixel (integer math as written there; the float texture
// coordinates use `precise` so that no multiply-add is fused, matching the C code compiled with -ffp-contract=off).
// Local memory is one array of 32-bit words; 16-bit pixels are written with atomics, as two neighbours share a word.
// Not covered (gsvk_sprite_supported() in gs.c): sprites whose texture, frame or Z buffer overlap in memory, since
// their result depends on the order of the pixels.
layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, binding = 0) buffer Vram { uint vm[]; };
layout(std430, binding = 1) readonly buffer Xoff { uint xoff[]; };   // [0, 32*2048): xoff32, [33*2048, ...): xoff32z
layout(std430, binding = 2) readonly buffer Clut { uint clut[]; };
#define PRIM_FIELDS \
    int px0, px1, py0, py1, x0, y0; float u0, v0, du, dv; \
    uint rgba, fog, fbp, fbw, fpsm, fbmsk; \
    int scx0, scx1, scy0, scy1; \
    int tme, tbp, tbw, tpsm, tw, th, tcc, tfx, wms, wmt, minu, maxu, minv, maxv, bilinear, aem, ta0, ta1, csa, cpsm; \
    int ate, atst, aref, afail, abe, a, b, cc, d, fix, pabe, fba, colclamp, fge, need_dst, zte, ztst; \
    uint fogcol; \
    uint z, zbp; int zpsm, zmsk, zread, date, datm, fb16; \
    int prim, iip, fst; \
    float tx0, ty0, tx1, ty1, tx2, ty2, tinv, tu0, tu1, tu2, tv0, tv1, tv2, tq0, tq1, tq2; \
    uint tc0, tc1, tc2, tz0, tz1, tz2; int tf0, tf1, tf2; \
    int lx0, ly0, lx1, ly1, ln; \
    int serial; \
    uint clutoff; \
    uint mbase;
// prim 0: sprite (px0.. are its pixel rectangle), 1: triangle (px0.. its bounding box), 2: line from (lx0,ly0) to
// (lx1,ly1) in ln steps, 3: point at (lx0,ly0) with texel (x0,y0)
// mbase: the word where the copy of local memory this primitive draws into starts (0: the exact one; others:
// sub-pixel offset copies for upscaling, HG_GSVK_SCALE). The primitives, in a ring the CPU fills; push constants: a batch's count, origin and first primitive, or (one
// primitive at a time) its index in n
struct Prim { PRIM_FIELDS };
layout(std430, binding = 3) readonly buffer Prims { Prim prims[]; };
layout(push_constant) uniform PC { int n, bx0, by0, first; } pc;
Prim p;
layout(std430, binding = 4) readonly buffer Tables { int tab[]; };   // see gsvk_init(): block and column tables
const int BT8 = 0, CT8 = 32, BT4 = 288, CT4 = 320, BT16 = 832, BT16S = 864, BT16Z = 896, CT16 = 928;

const int CT32 = 0x00, CT24 = 0x01, CT16x = 0x02, CT16S = 0x0a, T8 = 0x13, T4 = 0x14, T8H = 0x1b, T4HL = 0x24, T4HH = 0x2c,
          Z32 = 0x30, Z24 = 0x31, Z16 = 0x32, Z16S = 0x3a;

uint addr32(uint bp, uint bw, int x, int y, uint table) {
    return (bp * 64u + uint(y >> 5) * bw * 2048u + xoff[table + uint(y & 31) * 2048u + uint(x & 2047)]) & 0xFFFFFu;
}
uint addr16(uint bp, uint bw, int x, int y, int bt) {   // halfword index
    uint page = uint((x >> 6) + (y >> 6) * int(bw));
    return ((bp + page * 32u + uint(tab[bt + ((y >> 3) & 7) * 4 + ((x >> 4) & 3)])) * 128u + uint(tab[CT16 + (y & 7) * 16 + (x & 15)])) & 0x1FFFFFu;
}
uint addr8(uint bp, uint bw, int x, int y) {            // byte index
    uint page = uint((x >> 7) + (y >> 6) * int((bw + 1u) >> 1));
    return ((bp + page * 32u + uint(tab[BT8 + ((y >> 4) & 3) * 8 + ((x >> 4) & 7)])) * 256u + uint(tab[CT8 + (y & 15) * 16 + (x & 15)])) & 0x3FFFFFu;
}
uint addr4(uint bp, uint bw, int x, int y) {            // nibble index
    uint page = uint((x >> 7) + (y >> 7) * int((bw + 1u) >> 1));
    return ((bp + page * 32u + uint(tab[BT4 + ((y >> 4) & 7) * 4 + ((x >> 5) & 3)])) * 512u + uint(tab[CT4 + (y & 15) * 32 + (x & 31)])) & 0x7FFFFFu;
}
uint rd16(uint h) { return (vm[p.mbase + (h >> 1)] >> ((h & 1u) * 16u)) & 0xFFFFu; }
void wr16(uint h, uint v) { uint sh = (h & 1u) * 16u; atomicAnd(vm[p.mbase + (h >> 1)], ~(0xFFFFu << sh)); atomicOr(vm[p.mbase + (h >> 1)], (v & 0xFFFFu) << sh); }
int bt16of(int psm) { return psm == CT16S ? BT16S : (psm == Z16 || psm == Z16S) ? BT16Z : BT16; }
// read_px()/write_px() of gs.c for the formats used here
uint read_px(uint bp, uint bw, int psm, int x, int y) {
    if (psm == CT32 || psm == CT24) return vm[p.mbase + (addr32(bp, bw, x, y, 0u))];
    if (psm == Z32 || psm == Z24) return vm[p.mbase + (addr32(bp, bw, x, y, 33u * 2048u))];
    if (psm == CT16x || psm == CT16S || psm == Z16 || psm == Z16S) return rd16(addr16(bp, bw, x, y, bt16of(psm)));
    if (psm == T8) { uint a = addr8(bp, bw, x, y); return (vm[p.mbase + (a >> 2)] >> ((a & 3u) * 8u)) & 255u; }
    if (psm == T4) { uint a = addr4(bp, bw, x, y); return (vm[p.mbase + (a >> 3)] >> ((a & 7u) * 4u)) & 15u; }
    if (psm == T8H) return vm[p.mbase + (addr32(bp, bw, x, y, 0u))] >> 24;
    if (psm == T4HL) return (vm[p.mbase + (addr32(bp, bw, x, y, 0u))] >> 24) & 15u;
    if (psm == T4HH) return vm[p.mbase + (addr32(bp, bw, x, y, 0u))] >> 28;
    return vm[p.mbase + (addr32(bp, bw, x, y, 0u))];
}
void write_px(uint bp, uint bw, int psm, int x, int y, uint v) {   // frame and Z formats
    if (psm == CT32) vm[p.mbase + (addr32(bp, bw, x, y, 0u))] = v;
    else if (psm == CT24) { uint a = addr32(bp, bw, x, y, 0u); vm[p.mbase + (a)] = (vm[p.mbase + (a)] & 0xFF000000u) | (v & 0xFFFFFFu); }
    else if (psm == Z32) vm[p.mbase + (addr32(bp, bw, x, y, 33u * 2048u))] = v;
    else if (psm == Z24) { uint a = addr32(bp, bw, x, y, 33u * 2048u); vm[p.mbase + (a)] = (vm[p.mbase + (a)] & 0xFF000000u) | (v & 0xFFFFFFu); }
    else wr16(addr16(bp, bw, x, y, bt16of(psm)), v);
}
uint c16to32(uint c, int aem, uint ta0, uint ta1) {
    uint r = (c & 31u) << 3, g = ((c >> 5) & 31u) << 3, b = ((c >> 10) & 31u) << 3;
    uint a = (c & 0x8000u) != 0u ? ta1 : (aem != 0 && (c & 0x7FFFu) == 0u) ? 0u : ta0;
    return r | g << 8 | b << 16 | a << 24;
}
uint c32to16(uint c) { return ((c >> 3) & 31u) | (((c >> 11) & 31u) << 5) | (((c >> 19) & 31u) << 10) | ((c >> 16) & 0x8000u); }
int wrapc(int v, int size, int mode, int mn, int mx) {
    if (mode == 0) return v & (size - 1);
    if (mode == 1) return v < 0 ? 0 : v >= size ? size - 1 : v;
    if (mode == 2) return v < mn ? mn : v > mx ? mx : v;
    return (v & mn) | mx;
}
uint texel(int u, int v) {
    u = wrapc(u, p.tw, p.wms, p.minu, p.maxu); v = wrapc(v, p.th, p.wmt, p.minv, p.maxv);
    uint bp = uint(p.tbp), bw = uint(p.tbw); int psm = p.tpsm;
    if (psm == CT32 || psm == Z32) return read_px(bp, bw, psm, u, v);
    if (psm == CT24 || psm == Z24) { uint c = read_px(bp, bw, psm == CT24 ? CT32 : Z32, u, v) & 0xFFFFFFu; return c | (uint((p.aem != 0 && c == 0u) ? 0 : p.ta0) << 24); }
    if (psm == CT16x || psm == CT16S || psm == Z16 || psm == Z16S) return c16to32(read_px(bp, bw, psm, u, v), p.aem, uint(p.ta0), uint(p.ta1));
    if (psm == T8 || psm == T8H) return clut[p.clutoff + (read_px(bp, bw, psm, u, v) & 255u)];
    if (psm == T4 || psm == T4HL || psm == T4HH) return clut[p.clutoff + ((uint((p.cpsm == CT32 ? (p.csa & 15) : p.csa) * 16) + read_px(bp, bw, psm, u, v)) & 255u)];
    return read_px(bp, bw, CT32, u, v);
}
uint sample_(int u16, int v16) {
    if (p.bilinear == 0) return texel(u16 >> 4, v16 >> 4);
    int u = u16 - 8, v = v16 - 8, fu = u & 15, fv = v & 15; u >>= 4; v >>= 4;
    if (fu == 0 && fv == 0) return texel(u, v);
    uint c00 = texel(u, v), c10 = fu != 0 ? texel(u + 1, v) : 0u, c01 = fv != 0 ? texel(u, v + 1) : 0u, c11 = (fu != 0 && fv != 0) ? texel(u + 1, v + 1) : 0u;
    uint w00 = uint((16 - fu) * (16 - fv)), w10 = uint(fu * (16 - fv)), w01 = uint((16 - fu) * fv), w11 = uint(fu * fv);
    uint rb = ((c00 & 0xFF00FFu) * w00 + (c10 & 0xFF00FFu) * w10 + (c01 & 0xFF00FFu) * w01 + (c11 & 0xFF00FFu) * w11) >> 8;
    uint ag = (((c00 >> 8) & 0xFF00FFu) * w00 + ((c10 >> 8) & 0xFF00FFu) * w10 + ((c01 >> 8) & 0xFF00FFu) * w01 + ((c11 >> 8) & 0xFF00FFu) * w11) >> 8;
    return (rb & 0xFF00FFu) | ((ag & 0xFF00FFu) << 8);
}
uint shade(uint vcol, int u16, int v16, uint fog) {
    uint c = vcol;
    if (p.tme != 0) {
        uint t = sample_(u16, v16); int ta = int(t >> 24), fa = int(vcol >> 24); uint o = 0u;
        for (int s = 0; s < 24; s += 8) {
            int ct = int((t >> s) & 255u), cf = int((vcol >> s) & 255u), v;
            if (p.tfx == 0) v = ct * cf >> 7; else if (p.tfx == 1) v = ct; else v = (ct * cf >> 7) + fa;
            o |= uint(v > 255 ? 255 : v) << s;
        }
        int a;
        if (p.tfx == 0) a = p.tcc != 0 ? ta * fa >> 7 : fa; else if (p.tfx == 1) a = p.tcc != 0 ? ta : fa;
        else if (p.tfx == 2) a = p.tcc != 0 ? ta + fa : fa; else a = p.tcc != 0 ? ta : fa;
        c = o | (uint(a > 255 ? 255 : a) << 24);
    }
    if (p.fge != 0) {
        uint o = c & 0xFF000000u;
        for (int s = 0; s < 24; s += 8) o |= ((((c >> s) & 255u) * fog + ((p.fogcol >> s) & 255u) * (255u - fog)) >> 8) << s;
        c = o;
    }
    return c;
}
int clamp255(int v, int cc) { return cc != 0 ? (v < 0 ? 0 : v > 255 ? 255 : v) : (v & 255); }
// float -> int as x86 cvttss2si does it (gs.c's (int) casts): out of range and NaN give 0x80000000
int cvt(float f) { return abs(f) < 2147483648.0 ? int(f) : int(0x80000000u); }
// a / b rounded correctly (GPU division may be off by an ulp or two): step to the neighbour whose exact remainder,
// from a fused multiply-add, is smaller
float divx(float a, float b) {
    precise float q = a / b;
    if (q == 0.0 || isinf(q) || isnan(q)) return q;
    for (int i = 0; i < 4; i++) {
        float qu = uintBitsToFloat(floatBitsToUint(q) + 1u), qd = uintBitsToFloat(floatBitsToUint(q) - 1u);
        precise float r = abs(fma(-b, q, a)), ru = abs(fma(-b, qu, a)), rd = abs(fma(-b, qd, a));
        if (ru < r) q = qu; else if (rd < r) q = qd; else break;
    }
    return q;
}
// lroundf(): to nearest, halves away from zero (v - trunc(v) is exact)
int lround_(float v) { float r = trunc(v); precise float f = v - r; if (abs(f) >= 0.5) r += sign(v); return cvt(r); }
// pixel() of gs.c, in its order
void pixel(int x, int y, uint zv, uint col) {
    if (x < p.scx0 || x > p.scx1 || y < p.scy0 || y > p.scy1) return;
    int as_ = int(col >> 24); bool fb_ok = true, z_ok = true, rgb_only = false;
    if (p.ate != 0) {
        bool pass;
        if (p.atst == 0) pass = false; else if (p.atst == 1) pass = true; else if (p.atst == 2) pass = as_ < p.aref; else if (p.atst == 3) pass = as_ <= p.aref;
        else if (p.atst == 4) pass = as_ == p.aref; else if (p.atst == 5) pass = as_ >= p.aref; else if (p.atst == 6) pass = as_ > p.aref; else pass = as_ != p.aref;
        if (!pass) { if (p.afail == 0) return; if (p.afail == 1) z_ok = false; else if (p.afail == 2) fb_ok = false; else { z_ok = false; rgb_only = true; } }
    }
    uint dst = 0u, dst32 = 0u;
    if (p.need_dst != 0) { dst = read_px(p.fbp, p.fbw, int(p.fpsm), x, y); dst32 = p.fb16 != 0 ? c16to32(dst, 0, 0u, 0x80u) : dst; }
    if (p.date != 0) { int bit = p.fb16 != 0 ? int((dst >> 15) & 1u) : int((dst >> 31) & 1u); if (bit != p.datm) return; }
    if (p.zte != 0) {
        if (p.ztst == 0) return;
        if (p.zread != 0) {
            uint zd = read_px(p.zbp, p.fbw, p.zpsm, x, y);
            if (p.zpsm == Z24) zd &= 0xFFFFFFu;
            if (p.ztst == 2 ? zv < zd : zv <= zd) return;
        }
    } else z_ok = false;
    if (fb_ok) {
        uint o = col;
        if (p.abe != 0 && !(p.pabe != 0 && (as_ & 0x80) == 0)) {
            int ad = int(dst32 >> 24), cf = p.cc == 0 ? as_ : p.cc == 1 ? ad : p.fix;
            o = 0u;
            for (int s = 0; s < 24; s += 8) {
                int cs = int((col >> s) & 255u), cd = int((dst32 >> s) & 255u);
                int A = p.a == 0 ? cs : p.a == 1 ? cd : 0, B = p.b == 0 ? cs : p.b == 1 ? cd : 0, D = p.d == 0 ? cs : p.d == 1 ? cd : 0;
                o |= uint(clamp255(((A - B) * cf >> 7) + D, p.colclamp)) << s;
            }
            o |= col & 0xFF000000u;
        }
        if (p.fba != 0) o |= 0x80000000u;
        if (rgb_only) o = (o & 0xFFFFFFu) | (dst32 & 0xFF000000u);
        if (p.fb16 != 0) { uint o16 = c32to16(o); o16 = (o16 & ~p.fbmsk) | (dst & p.fbmsk & 0xFFFFu); write_px(p.fbp, p.fbw, int(p.fpsm), x, y, o16); }
        else if (int(p.fpsm) == CT24 || int(p.fpsm) == Z24) { uint a = addr32(p.fbp, p.fbw, x, y, int(p.fpsm) == Z24 ? 33u * 2048u : 0u); vm[p.mbase + (a)] = (dst & 0xFF000000u) | (((o & ~p.fbmsk) | (dst & p.fbmsk)) & 0xFFFFFFu); }
        else vm[p.mbase + (addr32(p.fbp, p.fbw, x, y, int(p.fpsm) == Z32 ? 33u * 2048u : 0u))] = (o & ~p.fbmsk) | (dst & p.fbmsk);
    }
    if (z_ok && p.zmsk == 0) write_px(p.zbp, p.fbw, p.zpsm, x, y, zv);
}
// one pixel of a sprite, triangle or point, at (x, y) inside its rectangle
void draw_at(int x, int y) {
    if (p.prim == 3) { pixel(x, y, p.z, shade(p.rgba, p.x0, p.y0, p.fog)); return; }
    if (p.prim == 0) {
        precise float uu = p.u0 + float((x << 4) - p.x0) * p.du;
        precise float vv = p.v0 + float((y << 4) - p.y0) * p.dv;
        pixel(x, y, p.z, shade(p.rgba, cvt(uu), cvt(vv), p.fog));
        return;
    }
    // draw_triangle()
    float px = float(x), py = float(y);
    precise float w0 = ((p.tx1 - px) * (p.ty2 - py) - (p.tx2 - px) * (p.ty1 - py)) * p.tinv;
    precise float w1 = ((p.tx2 - px) * (p.ty0 - py) - (p.tx0 - px) * (p.ty2 - py)) * p.tinv;
    precise float w2 = 1.0 - w0 - w1;
    if (w0 < -1e-6 || w1 < -1e-6 || w2 < -1e-6) return;
    uint col;
    if (p.iip != 0) {
        col = 0u;
        for (int s = 0; s < 32; s += 8) {
            precise float c = float((p.tc0 >> s) & 255u) * w0 + float((p.tc1 >> s) & 255u) * w1 + float((p.tc2 >> s) & 255u) * w2;
            precise float c5 = c + 0.5;
            int ci = cvt(c5); col |= uint(ci < 0 ? 0 : ci > 255 ? 255 : ci) << s;
        }
    } else col = p.tc2;
    precise double zf = double(p.tz0) * double(w0) + double(p.tz1) * double(w1) + double(p.tz2) * double(w2);
    uint zv = zf <= 0.0lf ? 0u : zf >= 4294967295.0lf ? 0xFFFFFFFFu : uint(zf);
    int u16 = 0, v16 = 0;
    if (p.tme != 0) {
        precise float q = p.tq0 * w0 + p.tq1 * w1 + p.tq2 * w2;
        precise float uu = p.tu0 * w0 + p.tu1 * w1 + p.tu2 * w2, vv = p.tv0 * w0 + p.tv1 * w1 + p.tv2 * w2;
        if (p.fst == 0 && q != 0.0) { uu = divx(uu, q); vv = divx(vv, q); }
        u16 = cvt(uu); v16 = cvt(vv);
    }
    precise float ff = float(p.tf0) * w0 + float(p.tf1) * w1 + float(p.tf2) * w2;
    pixel(x, y, zv, shade(col, u16, v16, uint(cvt(ff))));
}
#ifdef BATCH
// The workgroup's 8x8 tile first marks, 256 primitives at a time, those whose rectangle meets it (one bit each, so
// the order stays), then every invocation draws the marked ones at its pixel.
shared uint hits[8];
void main() {
    uint lid = gl_LocalInvocationIndex;
    int x = pc.bx0 + int(gl_GlobalInvocationID.x), y = pc.by0 + int(gl_GlobalInvocationID.y);
    int tx0 = pc.bx0 + int(gl_WorkGroupID.x) * 8, ty0 = pc.by0 + int(gl_WorkGroupID.y) * 8;
    for (int base = 0; base < pc.n; base += 256) {
        if (lid < 8u) hits[lid] = 0u;
        barrier();
        for (int k = 0; k < 4; k++) {
            int j = int(lid) * 4 + k, i = base + j;
            if (i < pc.n && prims[pc.first + i].px0 < tx0 + 8 && prims[pc.first + i].px1 > tx0 && prims[pc.first + i].py0 < ty0 + 8 && prims[pc.first + i].py1 > ty0)
                atomicOr(hits[j >> 5], 1u << (j & 31));
        }
        barrier();
        for (int w = 0; w < 8; w++) {
            uint m = hits[w];
            while (m != 0u) {
                int i = pc.first + base + w * 32 + findLSB(m); m &= m - 1u;
                if (x < prims[i].px0 || x >= prims[i].px1 || y < prims[i].py0 || y >= prims[i].py1) continue;
                p = prims[i];
                draw_at(x, y);
            }
        }
        barrier();
    }
}
#else
void line_step(int i) {   // draw_line()
    float t = p.ln != 0 ? divx(float(i), float(p.ln)) : 0.0;
    precise float fx = float(p.lx1 - p.lx0) * t, fy = float(p.ly1 - p.ly0) * t;
    pixel(p.lx0 + lround_(fx), p.ly0 + lround_(fy), p.z, shade(p.rgba, 0, 0, p.fog));
}
void main() {
    p = prims[pc.n];
    if (p.prim == 4) {   // upscaled display: hi-res pixel (X, Y) is pixel (X/N, Y/N) of copy 1 + X%N + (Y%N)*N
        int X = int(gl_GlobalInvocationID.x), Y = int(gl_GlobalInvocationID.y), N = p.ln;   // as display_from() in gs.c
        if (X >= p.px1 || Y >= p.py1) return;
        uint outw = p.z + uint(Y * p.px1 + X);
        p.mbase = uint(1 + X % N + (Y % N) * N) << 20;
        bool is16 = p.fpsm == 2u || p.fpsm == 10u;
        uint c = read_px(p.fbp, p.fbw, is16 ? int(p.fpsm) : CT32, p.lx0 + X / N, p.ly0 + Y / N);
        if (is16) c = c16to32(c, 0, 0u, 0x80u);
        vm[outw] = c & 0xFFFFFFu;
        return;
    }
    if (p.serial != 0) {   // primitives that read what they write: the CPU's order, rows then columns
        if (gl_GlobalInvocationID.x != 0u || gl_GlobalInvocationID.y != 0u) return;
        if (p.prim == 2) { for (int i = 0; i <= p.ln; i++) line_step(i); return; }
        for (int y = p.py0; y < p.py1; y++) for (int x = p.px0; x < p.px1; x++) draw_at(x, y);
        return;
    }
    int x = p.px0 + int(gl_GlobalInvocationID.x), y = p.py0 + int(gl_GlobalInvocationID.y);
    if (x >= p.px1 || y >= p.py1) return;
    if (p.prim == 2) { line_step(x); return; }   // x is the step
    draw_at(x, y);
}
#endif
