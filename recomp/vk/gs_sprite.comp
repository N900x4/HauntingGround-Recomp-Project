// The workgroup's 8x8 tile first marks, 256 primitives at a time, those whose rectangle meets it (one bit each, so
// the order stays), then every invocation draws the marked ones at its pixel.
shared uint hits[8];
#ifdef COPIES
// Upscaling: copy z of a primitive whose copies the GPU derives (gcopy): its geometry moved by the copy's sub-pixel
// offset, as gs.c moves the vertices for the copies it makes itself (sprites and points in whole 1/16 pixels; a
// primitive that textures from a render target reads at its coordinates minus the offset too). cn = N.
void apply_copy(int z) {
    load_mod();
    if (z == 0 || PF(gcopy) == 0) return;
    int N = PF(cn), ci = (z - 1) % N, cj = (z - 1) / N;
    float ox = float(2 * ci + 1) * 0.5 / float(N) - 0.5, oy = float(2 * cj + 1) * 0.5 / float(N) - 0.5;
    PF(mbase) += uint(z) << 20;
    if (PF(prim) == 1) {
        PF(tx0) -= ox; PF(tx1) -= ox; PF(tx2) -= ox; PF(ty0) -= oy; PF(ty1) -= oy; PF(ty2) -= oy;
        if (PF(rt) != 0) {
            PF(tu0) -= ox * 16.0 * PF(tq0); PF(tu1) -= ox * 16.0 * PF(tq1); PF(tu2) -= ox * 16.0 * PF(tq2);
            PF(tv0) -= oy * 16.0 * PF(tq0); PF(tv1) -= oy * 16.0 * PF(tq1); PF(tv2) -= oy * 16.0 * PF(tq2);
        }
        int nx0 = int(floor(min(PF(tx0), min(PF(tx1), PF(tx2))))), nx1 = int(ceil(max(PF(tx0), max(PF(tx1), PF(tx2)))));
        int ny0 = int(floor(min(PF(ty0), min(PF(ty1), PF(ty2))))), ny1 = int(ceil(max(PF(ty0), max(PF(ty1), PF(ty2)))));
        nx0 = max(nx0, PF(scx0)); nx1 = min(nx1, PF(scx1)); ny0 = max(ny0, PF(scy0)); ny1 = min(ny1, PF(scy1));
        PF(px0) = nx0; PF(px1) = nx1 >= nx0 ? nx1 + 1 : nx0; PF(py0) = ny0; PF(py1) = ny1 >= ny0 ? ny1 + 1 : ny0;
        return;
    }
    int oxi = int(round(ox * 16.0)), oyi = int(round(oy * 16.0));
    // A render target copied one texel per pixel (along an axis) is a memory operation, not a scene: the effect passes
    // that shuffle channels through 16-bit views draw 8-pixel strips with gaps, and moving those strips by under a
    // pixel left a column out at one edge and wrote one too many at the other in half the copies (dark lines every
    // 16 pixels, fixed on the screen). Each copy does the same operation on its own memory, unmoved.
    if (PF(rt) != 0) {
        if (PF(su1) - PF(su0) == float(PF(sx1) - PF(sx0))) oxi = 0;
        if (PF(sv1) - PF(sv0) == float(PF(sy1) - PF(sy0))) oyi = 0;
    }
    if (PF(prim) == 3) { PF(lx0) = (PF(sx0) - oxi) >> 4; PF(ly0) = (PF(sy0) - oyi) >> 4; PF(px0) = PF(lx0); PF(px1) = PF(lx0) + 1; PF(py0) = PF(ly0); PF(py1) = PF(ly0) + 1; return; }
    if (PF(prim) != 0) return;
    int x0 = PF(sx0) - oxi, x1 = PF(sx1) - oxi, y0 = PF(sy0) - oyi, y1 = PF(sy1) - oyi;   // sprite_geo()
    float u0 = PF(su0), v0 = PF(sv0), u1 = PF(su1), v1 = PF(sv1);
    if (x0 > x1) { int t = x0; x0 = x1; x1 = t; float f = u0; u0 = u1; u1 = f; }
    if (y0 > y1) { int t = y0; y0 = y1; y1 = t; float f = v0; v0 = v1; v1 = f; }
    int px0 = (x0 + 15) >> 4, px1 = (x1 + 15) >> 4, py0 = (y0 + 15) >> 4, py1 = (y1 + 15) >> 4;
    px0 = max(px0, PF(scx0)); px1 = min(px1, PF(scx1) + 1); py0 = max(py0, PF(scy0)); py1 = min(py1, PF(scy1) + 1);
    // a sprite that reaches the scissor's edge in the frame (c_px0 .. still hold copy 0's rectangle) reaches it in
    // every copy: moved by under a pixel it left the edge column of half the copies undrawn (a dark line at the border)
    if (PF(px0) <= PF(scx0)) px0 = PF(scx0);
    if (PF(px1) > PF(scx1)) px1 = PF(scx1) + 1;
    if (PF(py0) <= PF(scy0)) py0 = PF(scy0);
    if (PF(py1) > PF(scy1)) py1 = PF(scy1) + 1;
    PF(du) = x1 != x0 ? (u1 - u0) / float(x1 - x0) : 0.0; PF(dv) = y1 != y0 ? (v1 - v0) / float(y1 - y0) : 0.0;
    PF(px0) = px0; PF(px1) = px1; PF(py0) = py0; PF(py1) = py1; PF(x0) = x0; PF(y0) = y0; PF(u0) = u0; PF(v0) = v0;
    if (PF(rt) != 0) { PF(u0) -= float(oxi); PF(v0) -= float(oyi); }
}
// Does copy z of triangle i cover pixel (x, y)? Decided from its few geometry fields, so the whole primitive (about 120
// words) is loaded only for the triangles of a tile's list that do (about 7 % of the copies' time). The test is
// draw_at()'s with a looser bound (no `precise` here), so a pixel it keeps may still be dropped there, never the reverse.
bool covers(int i, int z, int x, int y) {
    if (prims[i].prim != 1) return true;
    int N = prims[i].cn, ci = (z - 1) % N, cj = (z - 1) / N;
    float ox = float(2 * ci + 1) * 0.5 / float(N) - 0.5, oy = float(2 * cj + 1) * 0.5 / float(N) - 0.5;
    float tx0 = prims[i].tx0 - ox, tx1 = prims[i].tx1 - ox, tx2 = prims[i].tx2 - ox, ty0 = prims[i].ty0 - oy, ty1 = prims[i].ty1 - oy, ty2 = prims[i].ty2 - oy;
    float px = float(x), py = float(y), tinv = prims[i].tinv;
    float w0 = ((tx1 - px) * (ty2 - py) - (tx2 - px) * (ty1 - py)) * tinv;
    float w1 = ((tx2 - px) * (ty0 - py) - (tx0 - px) * (ty2 - py)) * tinv;
    return w0 >= -1e-5 && w1 >= -1e-5 && 1.0 - w0 - w1 >= -1e-5;
}
