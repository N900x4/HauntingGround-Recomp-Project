        for (int k = 0; k < 4; k++) {
            int j = int(lid) * 4 + k, i = base + j, q = pc.first + i;
#ifdef COPIES
            if (binned && i < nper && ((bins[binbase + (i >> 5)] >> (i & 31)) & 1u) == 0u) continue;
#endif
            int mg = zc > 0 ? 2 : 0;   /* a copy moves by less than a pixel */
            if (i < nper && (zc == 0 || prims[q].gcopy != 0) && prims[q].px0 - mg < tx1 && prims[q].px1 + mg > tx0 && prims[q].py0 - mg < ty1 && prims[q].py1 + mg > ty0)
                atomicOr(hits[j >> 5], 1u << (j & 31));
        }
        barrier();
        for (int w = 0; w < 8; w++) {
