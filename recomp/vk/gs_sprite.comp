    p = prims[pc.n];
    if (PF(prim) == 4) {   // display: picture pixel (X, Y) is pixel (X/N, Y/N) of copy ly1 + X%N + (Y%N)*N
        int X = int(gl_GlobalInvocationID.x), Y = int(gl_GlobalInvocationID.y), N = PF(ln);   // as display_from() in gs.c
        if (X >= PF(px1) || Y >= PF(py1)) return;
