void line_step(int i) {   // draw_line()
    float t = PF(ln) != 0 ? divx(float(i), float(PF(ln))) : 0.0;
    precise float fx = float(PF(lx1) - PF(lx0)) * t, fy = float(PF(ly1) - PF(ly0)) * t;
