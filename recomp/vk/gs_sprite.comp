    else if (psm == CT24) { uint a = addr32(bp, bw, x, y, 0u); VM(a) = (VM(a) & 0xFF000000u) | (v & 0xFFFFFFu); }
    else if (psm == Z32) VM(addr32(bp, bw, x, y, 33u * 2048u)) = v;
    else if (psm == Z24) { uint a = addr32(bp, bw, x, y, 33u * 2048u); VM(a) = (VM(a) & 0xFF000000u) | (v & 0xFFFFFFu); }
    else wr16(addr16(bp, bw, x, y, bt16of(psm)), v);
