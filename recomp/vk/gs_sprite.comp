    if (psm == Z32 || psm == Z24) return VM(addr32(bp, bw, x, y, 33u * 2048u));
    if (psm == CT16x || psm == CT16S || psm == Z16 || psm == Z16S) return rd16(addr16(bp, bw, x, y, bt16of(psm)));
    if (psm == T8) { uint a = addr8(bp, bw, x, y); return (VM(a >> 2) >> ((a & 3u) * 8u)) & 255u; }
    if (psm == T4) { uint a = addr4(bp, bw, x, y); return (VM(a >> 3) >> ((a & 7u) * 4u)) & 15u; }
    if (psm == T8H) return VM(addr32(bp, bw, x, y, 0u)) >> 24;
    if (psm == T4HL) return (VM(addr32(bp, bw, x, y, 0u)) >> 24) & 15u;
    if (psm == T4HH) return VM(addr32(bp, bw, x, y, 0u)) >> 28;
