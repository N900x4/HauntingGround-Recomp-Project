// one pixel of a sprite, triangle or point, at (x, y) inside its rectangle
void draw_at(int x, int y) {
    if (PF(prim) == 3) { pixel(x, y, PF(z), shade(PF(rgba), PF(x0), PF(y0), PF(fog))); return; }
    if (PF(prim) == 0) {
        precise float uu = PF(u0) + float((x << 4) - PF(x0)) * PF(du);
        precise float vv = PF(v0) + float((y << 4) - PF(y0)) * PF(dv);
        pixel(x, y, PF(z), shade(PF(rgba), cvt(uu), cvt(vv), PF(fog)));
        return;
    }
    // draw_triangle()
    float px = float(x), py = float(y);
    precise float w0 = ((PF(tx1) - px) * (PF(ty2) - py) - (PF(tx2) - px) * (PF(ty1) - py)) * PF(tinv);
    precise float w1 = ((PF(tx2) - px) * (PF(ty0) - py) - (PF(tx0) - px) * (PF(ty2) - py)) * PF(tinv);
    precise float w2 = 1.0 - w0 - w1;
    if (w0 < -1e-6 || w1 < -1e-6 || w2 < -1e-6) return;
    uint col;
    if (PF(iip) != 0) {
        col = 0u;
        for (int s = 0; s < 32; s += 8) {
            precise float c = float((PF(tc0) >> s) & 255u) * w0 + float((PF(tc1) >> s) & 255u) * w1 + float((PF(tc2) >> s) & 255u) * w2;
            precise float c5 = c + 0.5;
            int ci = cvt(c5); col |= uint(ci < 0 ? 0 : ci > 255 ? 255 : ci) << s;
        }
    } else col = PF(tc2);
    precise double zf = double(PF(tz0)) * double(w0) + double(PF(tz1)) * double(w1) + double(PF(tz2)) * double(w2);
    uint zv = zf <= 0.0lf ? 0u : zf >= 4294967295.0lf ? 0xFFFFFFFFu : uint(zf);
    int u16 = 0, v16 = 0;
    if (PF(tme) != 0) {
        precise float q = PF(tq0) * w0 + PF(tq1) * w1 + PF(tq2) * w2;
        precise float uu = PF(tu0) * w0 + PF(tu1) * w1 + PF(tu2) * w2, vv = PF(tv0) * w0 + PF(tv1) * w1 + PF(tv2) * w2;
        if (PF(fst) == 0 && q != 0.0) { uu = divx(uu, q); vv = divx(vv, q); }
        u16 = cvt(uu); v16 = cvt(vv);
    }
    precise float ff = float(PF(tf0)) * w0 + float(PF(tf1)) * w1 + float(PF(tf2)) * w2;
    pixel(x, y, zv, shade(col, u16, v16, uint(cvt(ff))));
}
