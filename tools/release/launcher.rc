#include <winver.h>
1 24 "launcher.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Haunting Ground Recomp launcher"
      VALUE "FileVersion", "0.1"
      VALUE "ProductName", "Haunting Ground Recomp (fan project, not affiliated with Capcom)"
      VALUE "ProductVersion", "0.1"
      VALUE "LegalCopyright", "GPL-3.0-or-later"
      VALUE "OriginalFilename", "HauntingGround.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
